{
  "identifier": "default",
  "description": "Settings and sync popup",
  "windows": ["settings", "popup"],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:default",
    "notification:default",
    "opener:allow-open-url",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }]
    },
    "opener:allow-open-path",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$APPLOG/**" },
        { "path": "$APPDATA/**" },
        { "path": "$APPCONFIG/**" },
        { "path": "$APPLOCALDATA/**" }
      ]
    },
    "autostart:default"
  ]
}
